{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lyric",
  "scopeName": "source.lyric",
  "fileTypes": [
    "lyr"
  ],
  "comment": "Made by tree-sitter-lyric's script/textmate.py from its grammar; do not edit.",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#attributes"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#types"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.lyric",
          "match": "//[/!].*$"
        },
        {
          "name": "comment.line.double-slash.lyric",
          "match": "//.*$"
        },
        {
          "include": "#block-comment"
        }
      ]
    },
    "block-comment": {
      "name": "comment.block.lyric",
      "begin": "/\\*",
      "end": "\\*/",
      "patterns": [
        {
          "include": "#block-comment"
        }
      ]
    },
    "escape": {
      "name": "constant.character.escape.lyric",
      "match": "(?:\\\\u\\{[0-9A-Fa-f]+\\}|\\\\x[0-9A-Fa-f]{2}|\\\\.)"
    },
    "interpolation": {
      "name": "meta.interpolation.lyric",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.begin.lyric"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.interpolation.end.lyric"
        }
      },
      "patterns": [
        {
          "name": "constant.other.format-spec.lyric",
          "match": ":[^}\\n]*(?=\\})"
        },
        {
          "include": "$self"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.lyric",
          "begin": "fr\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.lyric",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.lyric",
          "begin": "f\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#escape"
            },
            {
              "name": "constant.character.escape.lyric",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.lyric",
          "begin": "fr\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.lyric",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.double.lyric",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#escape"
            },
            {
              "name": "constant.character.escape.lyric",
              "match": "\\{\\{|\\}\\}"
            },
            {
              "include": "#interpolation"
            }
          ]
        },
        {
          "name": "string.quoted.raw.lyric",
          "begin": "r(#*)\"",
          "end": "\"\\1"
        },
        {
          "name": "string.quoted.triple.lyric",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "name": "string.quoted.double.lyric",
          "begin": "b\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "name": "string.quoted.double.lyric",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "include": "#escape"
            }
          ]
        },
        {
          "name": "string.quoted.single.lyric",
          "match": "'(?:[^'\\\\\\n]|\\\\u\\{[0-9A-Fa-f]+\\}|\\\\.)'"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.lyric",
          "match": "\\b(?:[0-9][0-9_]*\\.[0-9][0-9_]*(?:[eE][+-]?[0-9_]+)?(?:(?:f32|f64))?|[0-9][0-9_]*[eE][+-]?[0-9_]+(?:(?:f32|f64))?|[0-9][0-9_]*(?:f32|f64))\\b"
        },
        {
          "name": "constant.numeric.integer.lyric",
          "match": "\\b(?:0x[0-9A-Fa-f_]+|0o[0-7_]+|0b[01_]+|[0-9][0-9_]*)(?:(i8|i16|i32|i64|u8|u16|u32|u64)?)\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "entity.name.tag.attribute.lyric",
          "match": "@[A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*"
        },
        {
          "name": "punctuation.definition.attribute.lyric",
          "match": "@\\["
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b(fn|macro)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.function.lyric"
            },
            "2": {
              "name": "entity.name.function.lyric"
            }
          }
        },
        {
          "match": "\\b(struct|class|enum|interface|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.lyric"
            },
            "2": {
              "name": "entity.name.type.lyric"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "storage.type.function.lyric",
          "match": "\\b(?:macro|fn)\\b"
        },
        {
          "name": "keyword.control.return.lyric",
          "match": "\\b(?:return|yield)\\b"
        },
        {
          "name": "keyword.control.conditional.lyric",
          "match": "\\b(?:match|else|if)\\b"
        },
        {
          "name": "keyword.control.loop.lyric",
          "match": "\\b(?:continue|break|while|for|do|in)\\b"
        },
        {
          "name": "keyword.control.loop.lyric",
          "match": "\\b(?:loop)\\b(?=\\s+[A-Za-z_\\[{<\\\"(])"
        },
        {
          "name": "keyword.control.import.lyric",
          "match": "\\b(?:import)\\b"
        },
        {
          "name": "keyword.control.import.lyric",
          "match": "\\b(?:module)\\b(?=\\s+[A-Za-z_\\[{<\\\"(])"
        },
        {
          "name": "keyword.control.exception.lyric",
          "match": "\\btry\\?"
        },
        {
          "name": "keyword.control.exception.lyric",
          "match": "\\btry!"
        },
        {
          "name": "keyword.control.exception.lyric",
          "match": "\\b(?:catch|defer|throw|try)\\b"
        },
        {
          "name": "keyword.control.exception.lyric",
          "match": "\\b(?:throws)\\b(?=\\s+[A-Za-z_\\[{<\\\"(])"
        },
        {
          "name": "storage.type.lyric",
          "match": "\\b(?:interface|extend|struct|class|enum)\\b"
        },
        {
          "name": "storage.type.lyric",
          "match": "\\b(?:type)\\b(?=\\s+[A-Za-z_\\[{<\\\"(])"
        },
        {
          "name": "storage.modifier.lyric",
          "match": "\\b(?:internal|private|inline|static|mut|pub|var)\\b"
        },
        {
          "name": "storage.modifier.lyric",
          "match": "\\b(?:extern|opaque|params|sealed)\\b(?=\\s+[A-Za-z_\\[{<\\\"(])"
        },
        {
          "name": "keyword.operator.word.lyric",
          "match": "\\b(?:as|is)\\b"
        },
        {
          "name": "keyword.operator.word.lyric",
          "match": "\\b(?:with|by)\\b(?=\\s+[A-Za-z_\\[{<\\\"(])"
        },
        {
          "name": "keyword.other.lyric",
          "match": "\\b(?:macro|fn)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.lyric",
          "match": "\\btrue\\b"
        },
        {
          "name": "constant.language.boolean.lyric",
          "match": "\\bfalse\\b"
        },
        {
          "name": "constant.language.null.lyric",
          "match": "\\bnull\\b"
        },
        {
          "name": "variable.language.this.lyric",
          "match": "\\bthis\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.builtin.lyric",
          "match": "\\b(?:float32|float64|string|uint16|uint32|uint64|float|int16|int32|int64|never|uint8|Self|bool|char|int8|uint|void|int)\\b"
        },
        {
          "name": "entity.name.type.lyric",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)(!)(?=[({])",
          "captures": {
            "1": {
              "name": "entity.name.function.macro.lyric"
            },
            "2": {
              "name": "entity.name.function.macro.lyric"
            }
          }
        },
        {
          "match": "([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:<[^<>()]*>)?\\()",
          "captures": {
            "1": {
              "name": "entity.name.function.call.lyric"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.lyric",
          "match": "!in|\\&\\&=|\\*%=|\\+%=|\\-%=|\\.\\.\\.|\\.\\.=|<<=|>>=|\\?\\?=|\\|\\|=|!=|%=|\\&\\&|\\&=|\\*%|\\*=|\\+%|\\+\\+|\\+=|\\-%|\\-\\-|\\-=|\\->|\\.\\.|/=|::|<<|<=|==|=>|>=|>>|\\?\\.|\\?\\?|\\^=|\\|=|\\|\\||!|%|\\&|\\*|\\+|\\-|/|<|=|>|\\?|\\^|\\||\\~"
        }
      ]
    }
  }
}
