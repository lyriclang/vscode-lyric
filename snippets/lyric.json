{
    "Function": {
        "prefix": "fn",
        "body": ["fn ${1:name}(${2}): ${3:int} {", "    $0", "}"],
        "description": "A function declaration"
    },
    "Main function": {
        "prefix": "main",
        "body": ["fn main(): int {", "    $0", "    return 0;", "}"],
        "description": "The entry point"
    },
    "Struct": {
        "prefix": "struct",
        "body": ["struct ${1:Name} {", "    ${2:field}: ${3:int},$0", "}"],
        "description": "A struct declaration"
    },
    "Class": {
        "prefix": "class",
        "body": ["class ${1:Name} {", "    ${2:field}: ${3:int},$0", "}"],
        "description": "A class declaration"
    },
    "Enum": {
        "prefix": "enum",
        "body": ["enum ${1:Name} {", "    ${2:Variant},$0", "}"],
        "description": "An enum declaration"
    },
    "Interface": {
        "prefix": "interface",
        "body": ["interface ${1:Name} {", "    fn ${2:method}(${3}): ${4:int};$0", "}"],
        "description": "An interface declaration"
    },
    "Extend": {
        "prefix": "extend",
        "body": ["extend ${1:Type} {", "    $0", "}"],
        "description": "An extension block"
    },
    "Match expression": {
        "prefix": "match",
        "body": ["match (${1:value}) {", "    ${2:Pattern} => ${3:0},$0", "}"],
        "description": "A match with one arm to start from"
    },
    "For-in loop": {
        "prefix": "for",
        "body": ["for ${1:item} in ${2:items} {", "    $0", "}"],
        "description": "Iterate over a range, array or iterable"
    },
    "While loop": {
        "prefix": "while",
        "body": ["while (${1:condition}) {", "    $0", "}"],
        "description": "A while loop"
    },
    "If": {
        "prefix": "if",
        "body": ["if (${1:condition}) {", "    $0", "}"],
        "description": "An if statement"
    },
    "Import": {
        "prefix": "import",
        "body": ["import ${1:module};"],
        "description": "Import a module"
    },
    "Selective import": {
        "prefix": "importsel",
        "body": ["import ${1:module} { ${2:name} };"],
        "description": "Import selected names from a module"
    }
}
