{
  "name": "vscode-lyric",
  "displayName": "Lyric",
  "description": "Language support for Lyric: project-wide diagnostics, navigation, rename, semantic highlighting, build tasks, a run command, and a debugger that launches a file or attaches to a running host.",
  "version": "1.4.0",
  "publisher": "lyric",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/lyriclang/vscode-lyric" },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages"],

  "main": "./extension.js",

  "activationEvents": ["onLanguage:lyric"],

  "contributes": {
    "languages": [
      {
        "id": "lyric",
        "aliases": ["Lyric", "lyric"],
        "extensions": [".lyr"],
        "configuration": "./language-configuration.json"
      }
    ],

    "grammars": [
      {
        "language": "lyric",
        "scopeName": "source.lyric",
        "path": "./syntaxes/lyric.tmLanguage.json"
      }
    ],

    "commands": [
      {
        "command": "lyric.run",
        "title": "Lyric: Run File",
        "icon": "$(play)"
      },
      {
        "command": "lyric.restartServer",
        "title": "Lyric: Restart Language Server"
      }
    ],

    "snippets": [
      {
        "language": "lyric",
        "path": "./snippets/lyric.json"
      }
    ],

    "problemMatchers": [
      {
        "name": "lyric",
        "owner": "lyric",
        "source": "lyric",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+): (error|warning)\\[([A-Z0-9-]+)\\]: (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ],

    "breakpoints": [{ "language": "lyric" }],

    "debuggers": [
      {
        "type": "lyric",
        "label": "Lyric",
        "languages": ["lyric"],
        "configurationAttributes": {
          "launch": {
            "required": ["program"],
            "properties": {
              "program": {
                "type": "string",
                "description": "The .lyr file to debug (or a built .lyrbc). A source file is compiled by the debugger itself, unoptimized, so what runs is what the editor shows.",
                "default": "${file}"
              },
              "args": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Arguments handed to main(args: string[]).",
                "default": []
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop on the first line of main.",
                "default": false
              }
            }
          },
          "attach": {
            "required": ["port"],
            "properties": {
              "port": {
                "type": "number",
                "description": "The port the host serves its debug adapter on. The host runs the program and speaks the protocol from inside its own process; nothing is compiled or started here."
              },
              "host": {
                "type": "string",
                "description": "Where that port is.",
                "default": "127.0.0.1"
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "lyric",
            "request": "launch",
            "name": "Debug current file",
            "program": "${file}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Lyric: Debug current file",
            "body": {
              "type": "lyric",
              "request": "launch",
              "name": "Debug current file",
              "program": "^\"\\${file}\""
            }
          },
          {
            "label": "Lyric: Attach to a running host",
            "body": {
              "type": "lyric",
              "request": "attach",
              "name": "Attach to a running host",
              "port": 4711
            }
          }
        ]
      }
    ],

    "taskDefinitions": [
      {
        "type": "lyric",
        "properties": {
          "projectDir": {
            "type": "string",
            "description": "The directory whose build.lyr is run. Defaults to the workspace folder."
          }
        }
      }
    ],

    "keybindings": [
      {
        "command": "lyric.run",
        "key": "ctrl+f5",
        "when": "editorLangId == lyric"
      }
    ],

    "menus": {
      "editor/title/run": [
        {
          "command": "lyric.run",
          "when": "editorLangId == lyric",
          "group": "navigation"
        }
      ]
    },

    "configuration": {
      "title": "Lyric",
      "properties": {
        "lyric.executable": {
          "type": "string",
          "default": "lyric",
          "markdownDescription": "Path to the `lyric` driver. Leave it as `lyric` if the toolchain is on your `PATH`; otherwise point at the published binary.\n\nThe extension calls the **driver**, not `lyrc` or `lyrvm` — the driver is the one command that compiles and runs in one step."
        },
        "lyric.languageServer": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `lyrls`, the language server that produces the diagnostics.\n\nLeft empty it is looked for beside `#lyric.executable#` when that is a full path, and on your `PATH` otherwise — so in the usual case configuring the driver configures both."
        },
        "lyric.debugAdapter": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `lyrdbg`, the debug adapter behind F5.\n\nLeft empty it is looked for beside `#lyric.executable#` when that is a full path, and on your `PATH` otherwise — the same rule the language server follows."
        },
        "lyric.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Run the language server and show diagnostics while you type. Turning it off leaves highlighting and the run command in place."
        }
      }
    }
  },

  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
