{
  "name": "vscode-lyric",
  "displayName": "Lyric",
  "description": "Language support for Lyric 5: the toolchain's language server (diagnostics, navigation, rename, quick fixes, formatting, test lenses), build tasks, a run command, and a debugger over lldb that builds what it launches.",
  "version": "2.0.0",
  "publisher": "lyric",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/lyriclang/vscode-lyric" },
  "engines": { "vscode": "^1.80.0" },
  "categories": ["Programming Languages", "Debuggers"],

  "main": "./extension.js",

  "activationEvents": ["onLanguage:lyric", "workspaceContains:lyric.toml"],

  "contributes": {
    "languages": [
      {
        "id": "lyric",
        "aliases": ["Lyric", "lyric"],
        "extensions": [".lyr"],
        "configuration": "./language-configuration.json"
      }
    ],

    "grammars": [
      {
        "language": "lyric",
        "scopeName": "source.lyric",
        "path": "./syntaxes/lyric.tmLanguage.json"
      }
    ],

    "commands": [
      {
        "command": "lyric.run",
        "title": "Lyric: Run",
        "icon": "$(play)"
      },
      {
        "command": "lyric.restartServer",
        "title": "Lyric: Restart Language Server"
      },
      {
        "command": "lyric.showExpanded",
        "title": "Lyric: Show the File with Its Macros Expanded"
      },
      {
        "command": "lyric.runTest",
        "title": "Lyric: Run Test"
      },
      {
        "command": "lyric.debugTest",
        "title": "Lyric: Debug Test"
      }
    ],

    "snippets": [
      {
        "language": "lyric",
        "path": "./snippets/lyric.json"
      }
    ],

    "problemMatchers": [
      {
        "name": "lyric",
        "owner": "lyric",
        "source": "lyric",
        "fileLocation": ["autoDetect", "${workspaceFolder}"],
        "pattern": [
          {
            "regexp": "^(error|warning)\\[([A-Z0-9-]+)\\]: (.+)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "regexp": "^\\s*--> (.+):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ]
      }
    ],

    "breakpoints": [{ "language": "lyric" }],

    "debuggers": [
      {
        "type": "lyric",
        "label": "Lyric",
        "languages": ["lyric"],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "program": {
                "type": "string",
                "description": "What to build and debug: a package's directory, or a .lyr file of its own. The adapter builds it in the debug profile first; what runs is what the editor shows.",
                "default": "${workspaceFolder}"
              },
              "test": {
                "type": "string",
                "description": "Debug the package's tests whose names hold this text instead of its program — what a test's Debug lens sets."
              },
              "args": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Arguments handed to the program.",
                "default": []
              },
              "cwd": {
                "type": "string",
                "description": "The directory the program runs in. Defaults to the package's."
              },
              "env": {
                "type": "object",
                "description": "Environment variables for the program, beside the editor's."
              },
              "stopOnEntry": {
                "type": "boolean",
                "description": "Stop before the program's first instruction.",
                "default": false
              }
            }
          },
          "attach": {
            "properties": {
              "pid": {
                "type": ["number", "string"],
                "description": "The process to attach to.",
                "default": "${command:pickProcess}"
              },
              "program": {
                "type": "string",
                "description": "With waitFor: the binary whose next process to attach to."
              },
              "waitFor": {
                "type": "boolean",
                "description": "Wait for the next process of program to start.",
                "default": false
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "lyric",
            "request": "launch",
            "name": "Debug the package",
            "program": "${workspaceFolder}"
          }
        ],
        "configurationSnippets": [
          {
            "label": "Lyric: Debug the package",
            "body": {
              "type": "lyric",
              "request": "launch",
              "name": "Debug the package",
              "program": "^\"\\${workspaceFolder}\""
            }
          },
          {
            "label": "Lyric: Debug a test",
            "body": {
              "type": "lyric",
              "request": "launch",
              "name": "Debug a test",
              "program": "^\"\\${workspaceFolder}\"",
              "test": "${1:name}"
            }
          },
          {
            "label": "Lyric: Attach to a process",
            "body": {
              "type": "lyric",
              "request": "attach",
              "name": "Attach to a process",
              "pid": "^\"\\${command:pickProcess}\""
            }
          }
        ]
      }
    ],

    "taskDefinitions": [
      {
        "type": "lyric",
        "properties": {
          "projectDir": {
            "type": "string",
            "description": "The package's directory, the one its lyric.toml stands in. Defaults to the workspace folder."
          }
        }
      }
    ],

    "keybindings": [
      {
        "command": "lyric.run",
        "key": "ctrl+f5",
        "when": "editorLangId == lyric"
      }
    ],

    "menus": {
      "editor/title/run": [
        {
          "command": "lyric.run",
          "when": "editorLangId == lyric",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        { "command": "lyric.runTest", "when": "false" },
        { "command": "lyric.debugTest", "when": "false" },
        { "command": "lyric.showExpanded", "when": "editorLangId == lyric" }
      ]
    },

    "configuration": {
      "title": "Lyric",
      "properties": {
        "lyric.executable": {
          "type": "string",
          "default": "lyric",
          "markdownDescription": "Path to the `lyric` toolchain. Leave it as `lyric` if it is on your `PATH`; otherwise point at the binary.\n\nIt is the one program the extension starts: `lyric lsp` is the language server, `lyric dap` the debugger, and the run command and the tasks call its verbs."
        },
        "lyric.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Run the language server and show diagnostics while you type. Turning it off leaves highlighting and the run command in place."
        }
      }
    }
  },

  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
